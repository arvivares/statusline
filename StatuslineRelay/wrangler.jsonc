{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "statusline-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "statusline-relay",
      "database_id": "8eaca70f-f840-458d-aca2-343fd6cac0be",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "CREATE_RATE_LIMITER",
      "namespace_id": "41001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      "name": "CHANNEL_RATE_LIMITER",
      "namespace_id": "41002",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
  ],
  "triggers": {
    "crons": ["17 3 * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
