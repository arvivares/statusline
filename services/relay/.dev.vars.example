# Copy this file to .dev.vars for local relay development. Keep real values out
# of Git. Push is disabled unless both optional values are configured.
# FCM_SERVICE_ACCOUNT_JSON: service-account JSON with only FCM send permission.
FCM_SERVICE_ACCOUNT_JSON=
# 32-byte random key encoded as unpadded base64url; encrypts FIDs in D1.
PUSH_TOKEN_ENCRYPTION_KEY=
