root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{css,html,js,json,jsonc,md,mjs,ts,yaml,yml}]
indent_size = 2

[*.{kt,kts,rs,swift}]
indent_size = 4

[*.{ps1,sh}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
