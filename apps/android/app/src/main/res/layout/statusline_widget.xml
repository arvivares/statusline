<?xml version="1.0" encoding="utf-8"?>
<!-- Still Signature: a single surface. The meter spans the full content width. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">
  <FrameLayout
      android:id="@+id/widgetRoot"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:clickable="true"
      android:focusable="true"
      android:importantForAccessibility="yes">
    <LinearLayout
        android:id="@+id/widgetPopulated"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:importantForAccessibility="noHideDescendants">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_weekly_limit_label"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_weekly_limit_label"
            android:textSize="13sp"
            android:textColor="@color/data_plane_ink" />
        <TextView
            android:id="@+id/widgetState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_live_label"
            android:textSize="9sp"
            android:textColor="@color/data_plane_muted" />
      </LinearLayout>
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_marginTop="6dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="true">
          <TextView
              android:id="@+id/widgetQuotaNumber"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false"
              android:maxLines="1"
              android:ellipsize="end"
              android:text="@string/widget_quota_number_placeholder"
              android:textSize="54sp"
              android:textColor="@color/data_plane_ink"
              android:letterSpacing="-0.04" />
          <TextView
              android:id="@+id/widgetQuotaPercent"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false"
              android:maxLines="1"
              android:ellipsize="end"
              android:text="@string/widget_percent_symbol"
              android:textSize="20sp"
              android:textColor="@color/data_plane_muted"
              android:layout_marginStart="6dp" />
        </LinearLayout>
        <TextView
            android:importantForAccessibility="no"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
          <TextView
              android:id="@+id/widget_resets_label"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false"
              android:maxLines="1"
              android:ellipsize="end"
              android:text="@string/widget_resets_label"
              android:textSize="10sp"
              android:textColor="@color/data_plane_muted" />
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical">
            <TextView
                android:id="@+id/widgetResetTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/widget_reset_time_placeholder"
                android:textSize="18sp"
                android:textColor="@color/data_plane_ink" />
            <TextView
                android:id="@+id/widgetResetDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/widget_reset_date_placeholder"
                android:textSize="10sp"
                android:textColor="@color/data_plane_muted"
                android:layout_marginStart="5dp" />
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>
      <ImageView
          android:id="@+id/widgetMeter"
          android:layout_width="match_parent"
          android:layout_height="6dp"
          android:layout_marginTop="6dp"
          android:importantForAccessibility="no"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/widget_meter_preview" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widgetEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:visibility="gone"
        android:importantForAccessibility="noHideDescendants">
      <TextView
          android:id="@+id/widget_weekly_limit_label_empty"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:ellipsize="end"
          android:text="@string/widget_weekly_limit_label"
          android:textSize="12sp"
          android:textColor="@color/data_plane_ink" />
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical">
        <TextView
            android:id="@+id/widgetEmptyQuotaNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_empty_quota_placeholder"
            android:textSize="36sp"
            android:textColor="@color/data_plane_ink" />
        <TextView
            android:importantForAccessibility="no"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/widget_no_data_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_no_data_label"
            android:textSize="10sp"
            android:textColor="@color/data_plane_muted" />
      </LinearLayout>
      <ImageView
          android:id="@+id/widgetEmptyMeter"
          android:layout_width="match_parent"
          android:layout_height="4dp"
          android:layout_marginTop="6dp"
          android:importantForAccessibility="no"
          android:contentDescription="@null"
          android:scaleType="fitXY" />
      <TextView
          android:id="@+id/widget_connect_companion"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:ellipsize="end"
          android:text="@string/widget_connect_companion"
          android:textSize="10sp"
          android:textColor="@color/data_plane_muted"
          android:layout_marginTop="6dp" />
    </LinearLayout>
  </FrameLayout>
</FrameLayout>
