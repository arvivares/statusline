{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Statusline Companion",
        "width": 340,
        "height": 500,
        "minWidth": 340,
        "minHeight": 500,
        "maxWidth": 340,
        "maxHeight": 500,
        "visible": true,
        "focus": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "rpm": {
        "epoch": 0,
        "release": "1"
      }
    }
  }
}
