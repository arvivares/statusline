{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Statusline Companion",
        "width": 400,
        "height": 600,
        "minWidth": 400,
        "minHeight": 600,
        "maxWidth": 400,
        "maxHeight": 600,
        "visible": false,
        "focus": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis", "msi"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Spanish"],
        "compression": "lzma",
        "installerHooks": "windows/nsis-hooks.nsh"
      },
      "wix": {
        "language": "es-ES",
        "template": "windows/statusline-per-user.wxs"
      }
    }
  }
}
