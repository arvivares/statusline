# Copy this file to .env and load it into your shell before running a client.
# This development default is intentionally local and is not a secret.
STATUSLINE_RELAY_BASE_URL=http://127.0.0.1:8787

# Optional override when Statusline cannot discover Codex CLI automatically.
# STATUSLINE_CODEX_PATH=/absolute/path/to/codex

# Optional Android release signing. Keep real values only in your untracked
# .env and never commit the keystore or its passwords.
# STATUSLINE_ANDROID_KEYSTORE_FILE=/absolute/path/to/statusline-upload.jks
# STATUSLINE_ANDROID_KEYSTORE_PASSWORD=replace-me
# STATUSLINE_ANDROID_KEY_ALIAS=statusline-upload
# STATUSLINE_ANDROID_KEY_PASSWORD=replace-me

# Optional non-interactive Wrangler authentication for your own Cloudflare
# account. Interactive development can use `npx wrangler login` instead.
# CLOUDFLARE_ACCOUNT_ID=replace-me
# CLOUDFLARE_API_TOKEN=replace-me
